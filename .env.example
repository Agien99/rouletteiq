# ==========================================
# RouletteIQ - Environment Configuration
# ==========================================

# Application
API_TITLE=RouletteIQ API
API_VERSION=1.0.0
API_ENV=production

# Logging
LOG_LEVEL=INFO

# API Documentation
API_DOCS_ENABLED=false

# CORS
CORS_ORIGINS=https://rouletteiq.digitechgien.com.my

# PostgreSQL Database
# Replace placeholder values in the VPS .env
DATABASE_URL=postgresql://rouletteiq_app:YOUR_PASSWORD@127.0.0.1:5433/rouletteiq_db