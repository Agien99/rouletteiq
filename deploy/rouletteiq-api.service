[Unit]
Description=RouletteIQ FastAPI Backend
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=server
Group=server
WorkingDirectory=/var/www/rouletteiq
EnvironmentFile=/var/www/rouletteiq/.env
ExecStart=/var/www/rouletteiq/.venv/bin/uvicorn app.api.main:app --host 127.0.0.1 --port 8002 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target